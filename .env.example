# ==============================================================================
# DISCIPLINA WEB - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Update the values with secure production secrets.
# 3. Never commit the .env file to version control.
# ==============================================================================

# --- DATABASE CONFIGURATION (PostgreSQL 16) ---
POSTGRES_DB=disciplina_db
POSTGRES_USER=admin_disciplina
# Obligatorio: genere secretos distintos y aleatorios para cada entorno.
# Ejemplo: openssl rand -base64 36
POSTGRES_PASSWORD=<defina-un-secreto-aleatorio-del-administrador>
APP_DB_USER=disciplina_app
APP_DB_PASSWORD=<defina-un-secreto-aleatorio-del-usuario-de-aplicacion>

# --- CAPACITY PROFILE ---
# Defaults below are appropriate for a 1 GB trial host. They are not fixed in
# code: raise them together when moving to a larger instance.
POSTGRES_MEMORY_LIMIT=320M
POSTGRES_CPU_LIMIT=0.50
POSTGRES_MAX_CONNECTIONS=20
POSTGRES_SHARED_BUFFERS=64MB
POSTGRES_WORK_MEM=1MB
POSTGRES_MAINTENANCE_WORK_MEM=32MB
BACKEND_MEMORY_LIMIT=448M
FRONTEND_MEMORY_LIMIT=96M
# Only used when starting the optional `debug` profile.
PGADMIN_MEMORY_LIMIT=256M

# HikariCP: keep this aligned with the database capacity, not with the number
# of web users. Suggested starting points: 4 (1 GB), 8 (2 GB), 12-16 (4 GB).
DB_POOL_MAX_SIZE=4
DB_POOL_MIN_IDLE=1
DB_POOL_CONNECTION_TIMEOUT_MS=10000
DB_POOL_IDLE_TIMEOUT_MS=300000
DB_POOL_VALIDATION_TIMEOUT_MS=3000
DB_POOL_MAX_LIFETIME_MS=1200000

# Límites de seguridad para importaciones Excel. Auméntelos solo tras medir
# memoria y tiempo de procesamiento en el entorno de destino.
IMPORT_MAX_ROWS=10000
IMPORT_MAX_SHEETS=10

# --- SECURITY & AUTHENTICATION (Spring Security / JWT) ---
# 256-bit secret key (HMAC-SHA256). Generate one with: openssl rand -hex 32
JWT_SECRET=<defina-un-secreto-jwt-de-al-menos-32-bytes>
# Token expiration time in milliseconds (28800000 = 8 hours)
JWT_EXPIRATION_MS=28800000

# --- ARTIFICIAL INTELLIGENCE INTEGRATION (Google Gemini API) ---
# Leave empty if AI narrative assistance is not used, or provide your Gemini API key:
GEMINI_API_KEY=

# --- NETWORK & PORTS (Nginx Reverse Proxy) ---
# Public HTTP port bound on the host machine
HTTP_PORT=80
# Public HTTPS port bound on the host machine (for SSL/TLS with Certbot)
HTTPS_PORT=443

# Allowed CORS origins (comma-separated). Since Nginx reverse-proxies /api/ under the same domain,
# standard browser requests are same-origin. Add your custom domain/IP here as well:
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# --- DEBUG & ADMINISTRATION TOOLS (Optional) ---
# pgAdmin is disabled by default in production. Only run with: docker compose --profile debug up -d pgadmin
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@disciplina.local
PGADMIN_DEFAULT_PASSWORD=<defina-un-secreto-aleatorio-si-activa-pgadmin>
WHATSAPP_API_URL=https://graph.facebook.com/v25.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_TEMPLATE_NAME=citacion_incidente_convivencia
WHATSAPP_TEMPLATE_LANGUAGE=es_CO
