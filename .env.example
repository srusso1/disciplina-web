# =============================================================================
# DISCIPLINA WEB - Plantilla de Variables de Entorno (.env.example)
# =============================================================================
# Copie este archivo como .env y complete con sus credenciales reales.

# Google Gemini API
GEMINI_API_KEY=su_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=8

# Seguridad JWT (HMAC-SHA256, minimo 256 bits / 32 bytes)
# OBLIGATORIO en produccion — sin valor por defecto.
# Generar con: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
JWT_EXPIRATION_MS=28800000

# Base de Datos PostgreSQL
POSTGRES_DB=disciplina_db
POSTGRES_USER=admin_disciplina
POSTGRES_PASSWORD=secret_password_2026
POSTGRES_PORT=5432
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/disciplina_db
SPRING_DATASOURCE_USERNAME=admin_disciplina
SPRING_DATASOURCE_PASSWORD=secret_password_2026

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080/api/v1