# ==============================================================================
# DISCIPLINA WEB - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:  cp .env.example .env
# 2. Update the values with secure production secrets.
# 3. Never commit the .env file to version control.
# ==============================================================================

# --- DATABASE CONFIGURATION (PostgreSQL 16) ---
POSTGRES_DB=disciplina_db
POSTGRES_USER=admin_disciplina
# CHANGE THIS TO A STRONG PASSWORD IN PRODUCTION:
POSTGRES_PASSWORD=CambiarEstePasswordPorUnoSeguro2026!

# --- SECURITY & AUTHENTICATION (Spring Security / JWT) ---
# 256-bit secret key (HMAC-SHA256). Generate one with: openssl rand -hex 32
JWT_SECRET=e7b4a2c9183d5f0e6a4b2c8d1e9f3a5b7c0d2e4f6a8b1c3d5e7f9a0b2c4d6e8f
# Token expiration time in milliseconds (28800000 = 8 hours)
JWT_EXPIRATION_MS=28800000

# --- ARTIFICIAL INTELLIGENCE INTEGRATION (Google Gemini API) ---
# Leave empty if AI narrative assistance is not used, or provide your Gemini API key:
GEMINI_API_KEY=

# --- NETWORK & PORTS (Nginx Reverse Proxy) ---
# Public HTTP port bound on the host machine
HTTP_PORT=80
# Public HTTPS port bound on the host machine (for SSL/TLS with Certbot)
HTTPS_PORT=443

# Allowed CORS origins (comma-separated). Since Nginx reverse-proxies /api/ under the same domain,
# standard browser requests are same-origin. Add your custom domain/IP here as well:
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# --- DEBUG & ADMINISTRATION TOOLS (Optional) ---
# pgAdmin is disabled by default in production. Only run with: docker compose --profile debug up -d pgadmin
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@disciplina.local
PGADMIN_DEFAULT_PASSWORD=AdminDisciplinaSeguro2026!